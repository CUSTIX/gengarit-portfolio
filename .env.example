# Copy to .env (never committed) and fill in.
VITE_SITE_URL=https://your-domain.example      # absolute origin for OG/canonical URLs
VITE_SERVICE_ID=                               # EmailJS (public ids; optional, shipped defaults exist)
VITE_TEMPLATE_ID=
VITE_PUBLIC_KEY=
# Assistant. Prefer the server-side key (used by api/chat.js on Vercel);
# the VITE_ key is a client-side fallback that ships in the bundle.
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.5-flash
